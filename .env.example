# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Azure OpenAI Configuration
# Found in Azure AI Foundry -> Project Settings
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com"
AZURE_OPENAI_API_VERSION="2024-05-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-4.1-mini"

# JWT Configuration
# Required for verifying Supabase JWTs in guards
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Secret
JWT_SECRET="your-supabase-jwt-secret"

# Server Configuration
PORT=3000

# Frontend Configuration
# URL of the frontend application (used for auth redirects)
FRONTEND_URL="http://localhost:5173"

# GitHub OAuth Configuration (optional — enables "Deploy to GitHub Pages" feature)
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:5173/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
